[Unit]
Description=Asset Worldline Agent Worker
After=network.target

[Service]
User=asset-worldline
Group=asset-worldline
WorkingDirectory=/opt/asset-worldline/backend
EnvironmentFile=/etc/asset-worldline/config.env
ExecStart=/opt/asset-worldline/backend/.venv/bin/python -m app.workers.worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
